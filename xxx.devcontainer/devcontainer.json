{
"name": "ROS2_DEV",
"remoteUser": "rosdev",
"build": {
"dockerfile": "Dockerfile",
"args": {
"USERNAME": "rosdev",
"GID": "1000",
"UID": "1000"
}
},
"customizations": {
"vscode": {
"extensions": [
	"ms-python.python",
	"charliermarsh.ruff",
	"donjayamanne.python-extension-pack",
	"eamodio.gitlens",
	"ms-azuretools.vscode-docker",
	"ms-python.python",
	"ms-vscode.cmake-tools",
	"ms-vscode.cpptools",
	"ms-vscode.cpptools-extension-pack",
	"ms-vscode.cpptools-themes",
	"smilerobotics.urdf",
	"redhat.vscode-xml",
	"tamasfe.even-better-toml",
	"timonwong.shellcheck",
	"twxs.cmake",
	"yzhang.markdown-all-in-one",
	"Ranch-Hand-Robotics.urdf-editor",
	"vscodevim.vim",
	"GitHub.copilot"
],
"settings": {
"files.associations": {
"*.rviz": "yaml",
"*.srdf": "xml",
"*.urdf": "xml",
"*.xacro": "xml"
}
}
}
},
"workspaceFolder": "/home/rosdev/ros2_ws",  //This is the path inside container
"workspaceMount": "source=${localWorkspaceFolder},target=/home/rosdev/ros2_ws,type=bind",
"mounts": [
// EXAMPLE "source=/HOST_COMPUTER,target=/INSIDE_CONTAINER,type=bind",

// Allow use of USB ports (including gamepads/controllers)
{
"source": "/dev/input/",
"target": "/dev/input/",
"type": "bind"
},
{
"source": "/dev/bus/usb",
"target": "/dev/bus/usb",
"type": "bind"
},
// Allow the container to access the X server on the host e.g. to run Rviz and other GUI tools
{
"source": "/tmp/.X11-unix",
"target": "/tmp/.X11-unix",
"type": "bind"
},
{
"source": "${localEnv:XAUTHORITY:-$HOME/.Xauthority}",
"target": "/root/.Xauthority",
"type": "bind"
},

// Uncomment to persist bash history between sessions
{
"source": "${localEnv:HOME}${localEnv:USERPROFILE}/.bash_history",
"target": "/root/.bash_history",
"type": "bind"
}

],
"runArgs": [
"--network=host", // Shares the host's network namespace with the container
"--pid=host", // Shares the host's PID namespace with the container
"--privileged", // Gives the container full access to the host's devices and allows it to run with root privileges
"--cap-add=SYS_PTRACE", // Allows the container to trace processes using ptrace system call
"--security-opt=seccomp=unconfined", // Disables seccomp security profiles for the container
"--ipc=host" // Shares the host's IPC namespace with the container
]
}
